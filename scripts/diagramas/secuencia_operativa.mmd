sequenceDiagram
    autonumber
    actor Cron as Systemd / Cron (60s)
    participant Eng as AutomatedTradingEngine
    participant Mkt as Market Connector (yfinance/ccxt)
    participant Strat as OpeningRangeBreakoutStrategy
    participant Risk as RiskManager
    participant Rules as StellarLiteRulesEngine
    participant DB as TradingDatabase (SQLite)
    participant TG as TelegramNotifier

    Note over Cron, Eng: Inicio de Ciclo Cuantitativo (08:30-11:30 EST)
    Cron->>Eng: run_single_cycle()
    
    rect rgb(20, 35, 60)
        Note over Eng, DB: Fase 1: Gestión de Posiciones Abiertas
        Eng->>Mkt: get_latest_price(GC=F)
        Mkt-->>Eng: Mark Price Actual ($2672.23)
        Eng->>Eng: calculate_open_positions_floating_pnl()
        Eng->>Rules: evaluate_account(floating_pnl)
        Rules-->>Eng: RuleCheckResult (Piso Diario, Max DD $4,600)
        
        alt Equidad toca Piso Diario (4%) o Max DD (8%)
            Eng->>DB: record_trade_close(LIQUIDACION_FORZOSA_HARD_BREACH)
            Eng->>TG: notify_risk_alert("HARD_BREACH")
            Note over Eng: Bloqueo de Emergencia: Cuenta FALLADA
        else Operación alcanza +1R en Beneficio
            Eng->>DB: update_trade_stop_loss(Nuevo SL = Precio Entrada)
            Eng->>TG: notify_break_even(trade_id, +1R Blindado)
        else Operación toca TP (1:2) o SL
            Eng->>DB: record_trade_close(TAKE_PROFIT_HIT)
            Eng->>TG: notify_trade_closed(net_pnl, balance, equity)
        end
    end

    rect rgb(30, 45, 30)
        Note over Eng, Rules: Fase 2: Blindaje de Ganancias & Reglas de Fondeo
        alt Target de Fase alcanzado y hoy ya hay operaciones registradas
            Eng->>Eng: TARGET_REACHED_TODAY_SECURED
            Note over Eng: Freno Anti-Sobreoperación Activo (Capital Protegido)
        else Target alcanzado en día previo y esperando día 2 mínimo
            Eng->>Risk: calculate_position_size(Modo Micro-Lote 0.01 lotes)
            Note over Eng: Modo Micro-Lote de Seguridad (Riesgo < $1.00)
        end
    end

    rect rgb(45, 30, 50)
        Note over Eng, Strat: Fase 3: Análisis Técnico & Filtros Anti-Fakeout
        Eng->>Risk: validate_pre_trade()
        Risk-->>Eng: PreTradeRiskCheck (Sesión OK, Tilt < 3, Cap 2% OK)
        Eng->>Mkt: fetch_ohlcv_15m() & fetch_ohlcv_1h()
        Mkt-->>Eng: Velas 15m y 1H
        Eng->>Strat: evaluate(df_15m, df_1h)
        Strat->>Strat: Identifica Rango ORB (08:30 a 08:45 EST)
        Strat->>Strat: Anti-Fakeout: Cierre de vela > High o < Low (rechaza mechas)
        Strat->>Strat: Filtro Macro: Tendencia 1H con EMA 200
        Strat-->>Eng: Signal (BUY / SELL / NONE)
    end

    rect rgb(35, 40, 20)
        Note over Eng, TG: Fase 4: Ejecución Institucional & Notificación
        alt Señal Válida Confirmada
            Eng->>Risk: calculate_position_size(balance, entry, sl, risk=0.5%)
            Risk-->>Eng: PositionSizeResult (Lots, Units, SL, TP 1:2)
            Eng->>DB: record_trade_open(symbol, side, lots, SL, TP)
            DB-->>Eng: Trade #ID Registrado
            Eng->>TG: notify_trade_opened(Trade #ID, Lots, SL, TP, Risk USD)
        end
    end
